import pandas as pd
import tkinter as tk
from tkinter import filedialog

# ============================================================
# SELECT INPUT EXCEL FILE
# ============================================================

root = tk.Tk()
root.withdraw()

input_file = filedialog.askopenfilename(
    title="Select Water Level Excel File",
    filetypes=[
        ("Excel files", "*.xlsx *.xls")
    ]
)

if not input_file:
    print("No input file selected.")
    exit()


# ============================================================
# READ EXCEL FILE
# ============================================================

df = pd.read_excel(input_file)

# Second column = Water Level
water_level = pd.to_numeric(
    df.iloc[:, 1],
    errors="coerce"
).dropna()


# ============================================================
# CALCULATE STATISTICS
# ============================================================

statistics = {
    "Parameter": [
        "Standard Deviation",
        "Maximum",
        "Minimum",
        "Mean",
        "Quartile 1 (Q1)",
        "Quartile 2 (Q2 / Median)",
        "Quartile 3 (Q3)",
        "Q95",
        "Q98"
    ],

    "Water Level (m)": [
        water_level.std(),
        water_level.max(),
        water_level.min(),
        water_level.mean(),
        water_level.quantile(0.25),
        water_level.quantile(0.50),
        water_level.quantile(0.75),
        water_level.quantile(0.95),
        water_level.quantile(0.98)
    ]
}


statistics_df = pd.DataFrame(statistics)


# ============================================================
# DISPLAY RESULTS
# ============================================================

print("\nWater Level Statistics")
print("=" * 50)

print(statistics_df.to_string(index=False))


# ============================================================
# SELECT OUTPUT FILE
# ============================================================

output_file = filedialog.asksaveasfilename(
    title="Save Water Level Statistics",
    defaultextension=".xlsx",
    filetypes=[
        ("Excel files", "*.xlsx")
    ]
)

if not output_file:
    print("No output file selected.")
    exit()


# ============================================================
# EXPORT TO EXCEL
# ============================================================

statistics_df.to_excel(
    output_file,
    index=False,
    sheet_name="Water_Level_Statistics"
)


print("\nStatistics successfully exported to:")
print(output_file)

